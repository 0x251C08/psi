# Maintainer: 0x251C08 <armaansn.dev@gmail.com>
pkgname=psi
pkgver=0.1.0
pkgrel=1
pkgdesc="Developer quality-of-life tool for codebase inspection and project initialization"
arch=('any')
url="https://github.com/0x251C08/psi"
license=('MIT')
depends=(
    'python>=3.13'
    'python-typer>=0.12.0'
    'python-rich>=13.7.0'
    'python-textual>=0.52.0'
    'python-gitpython>=3.1.40'
    'python-pyyaml>=6.0.1'
    'python-tomli>=2.0.1'
    'python-tomli-w>=1.0.0'
    'python-packaging>=24.0'
    'python-platformdirs>=4.2.0'
)
makedepends=(
    'python-build'
    'python-installer'
    'python-wheel'
    'python-uv-build'
)
checkdepends=(
    'python-pytest'
    'python-pytest-mock'
)
source=("${url}/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('32e3c16d68955280cb67f5f97fb032ef511732ced0a84305dad6e73e1b8b3a50')

build() {
    cd "${pkgname}-${pkgver}"
    python -m build --wheel --no-isolation
}

check() {
    cd "${pkgname}-${pkgver}"
    python -m pytest tests/ -v
}

package() {
    cd "${pkgname}-${pkgver}"
    python -m installer --destdir="$pkgdir" dist/*.whl
}